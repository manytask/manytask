# Final course testenv image. It is built only after `checker check` passes.
#
# The private checkout exists solely in the `private-export` stage. Docker
# publishes the final stage, whose only course content is the materialized
# `checker export-private` result at /opt/course. Thus no final image layer
# contains the raw teacher repository or its Git history.

ARG BASE_IMAGE

FROM ${BASE_IMAGE} AS private-export

WORKDIR /build
COPY . /build
RUN checker export-private /build /opt/course

FROM ${BASE_IMAGE}

COPY --from=private-export /opt/course /opt/course
WORKDIR /workspace
